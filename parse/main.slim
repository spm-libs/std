use { readFile } from "node:fs/promises"
use { join } from "node:path"

export class ReadError extends Error {}

export async func parseJSON(fpath: string): object {
    try {
        const filePath: string = join(fpath); 
        const data: string = await readFile(filePath, 'utf8');

        return JSON.parse(data)
    } catch (err) {
        throw new ReadError(err)
    }
}
export async func parseText(fpath: string): string {
    try {
        const filePath: string = join(fpath); 
        const data: string = await readFile(filePath, 'utf8');

        return data
    } catch (err) {
        throw new ReadError(err)
    }
}