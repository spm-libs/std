use { sha256 } from "./sha256"
use { SHA256, QuickHash } from "../types/hash"

export default const StringHelper: object = {
    len(str: string): int {
        return str.length
    },
    truncate(str: string, maxLength: int): string {
        if (str.length > maxLength) {
            return str.slice(0, maxLength) + '...';
        }
        return str;
    },
    hash(str: string): SHA256 {
        return sha256(str)
    },
    pad(value: string | number, width: int, fill: string = "0"): string {
        if (typeof value == "number" && value < 0) return "-" + String(-value).padStart(width - 1, fill)
        return String(value).padStart(width, fill)
    },
    splitArgs(line: string): string[] {
        const parts: string[] = []
        const pattern = /"([^"]*)"?|'([^']*)'?|(\S+)/g
        let match = pattern.exec(line)
        while (match) {
            parts.push(match[1] ?? match[2] ?? match[3])
            match = pattern.exec(line)
        }
        return parts
    },
    quickHash(str: string): QuickHash {
        let hash = 0;
        for (let i = 0; i < str.length; i++) {
            hash = (hash << 5) - hash + str.charCodeAt(i);
            hash |= 0;
        }
        return hash;
    }
}

lock StringHelper;