export trait Random {
    next: () => number
    int: (low: number, high: number) => number
    float: (low: number, high: number) => number
    chance: (probability: number) => bool
    seed: () => number | null
    state: () => number | null
    setState: (state: number) => void
}

func seedState(seed: number): number {
    if (Number.isInteger(seed)) return seed >>> 0
    const text = String(seed)
    let hash = 0x811C9DC5
    for (let i = 0; i < text.length; i++) hash = Math.imul(hash ^ text.charCodeAt(i), 0x01000193)
    hash = Math.imul(hash ^ (hash >>> 16), 0x85EBCA6B)
    hash = Math.imul(hash ^ (hash >>> 13), 0xC2B2AE35)
    return (hash ^ (hash >>> 16)) >>> 0
}

export func createRandom(seed?: number): Random {
    let state = seed == undefined ? null : seedState(seed)

    func next(): number {
        if (state == null) return Math.random()
        state = (state + 0x6D2B79F5) >>> 0
        let t = state
        t = Math.imul(t ^ (t >>> 15), t | 1)
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61)
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296
    }

    return {
        next,
        int: (low: number, high: number) => {
            const min = Math.ceil(Math.min(low, high))
            const max = Math.floor(Math.max(low, high))
            if (!(min <= max) || !Number.isFinite(min) || !Number.isFinite(max)) throw new RangeError(`no whole number from ${low} to ${high}`)
            return min + Math.floor(next() * (max - min + 1))
        },
        float: (low: number, high: number) => low + next() * (high - low),
        chance: (probability: number) => next() < probability,
        seed: () => seed ?? null,
        state: () => state,
        setState: (saved: number) => {
            if (state == null) throw new Error("a random without a seed has no state to set")
            state = saved >>> 0
        },
    }
}

export func pick<T>(random: Random, items: T[]): T | undefined {
    return items.length ? items[Math.floor(random.next() * items.length)] : undefined
}

export func weighted<T>(random: Random, entries: [T, number][]): T | undefined {
    let total = 0
    for (const [_, weight] of entries) if (weight > 0) total += weight
    if (!(total > 0) || !Number.isFinite(total)) return undefined
    let left = random.next() * total
    let last: T | undefined = undefined
    for (const [value, weight] of entries) {
        if (!(weight > 0)) continue
        last = value
        left -= weight
        if (left < 0) return value
    }
    return last
}

export func shuffle<T>(random: Random, items: T[]): T[] {
    const out = items.slice()
    for (let i = out.length - 1; i > 0; i--) {
        const j = Math.floor(random.next() * (i + 1))
        const kept = out[i]
        out[i] = out[j]
        out[j] = kept
    }
    return out
}
