export type nonZero(v) extends number {
    return v != 0
}
export type even(v) extends int {
    return v % 2 == 0
}
export type odd(v) extends int {
    return v % 2 != 0
}
export type positive(v) extends number {
    return v > 0
}
export type negative(v) extends number {
    return v < 0
}
export type natural(v) extends int {
    return v >= 0
}
